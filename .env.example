# Copy to .env and fill in only what you need. All variables are optional.
# ohpert never reads this file directly; the server inherits variables from the
# process that starts it (for example `set -a; . ./.env; set +a; pnpm dev`).

# Any OpenAI-compatible endpoint. Must support function calling for the
# implementation and review stages.
OHPERT_LLM_BASE_URL=https://api.openai.com/v1
OHPERT_LLM_API_KEY=
OHPERT_LLM_MODEL=gpt-4o-mini

# Where the SQLite database, settings and temporary worktrees live.
# OHPERT_DATA_DIR=./.data

# HTTP port for the local API / production UI.
# PORT=5274

# Set to 0 to start with an empty database instead of the bundled demo.
# OHPERT_SEED_DEMO=1
